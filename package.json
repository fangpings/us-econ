{
  "name": "us-econ-textbook",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node tools/check_textbook.mjs && python3 -m unittest discover -s tests -v",
    "check:rendered": "python3 tools/check_rendered.py",
    "dev": "vitepress dev textbook --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vitepress build textbook",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort --outDir textbook/.vitepress/dist --base /us-econ/"
  },
  "devDependencies": {
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "^11.17.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
